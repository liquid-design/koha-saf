{# ============================================================================
   Apache vhost voor scan.<domain> — Flask ISBN-scan app
   Managed by Ansible (flask_isbn_app role)
   ----------------------------------------------------------------------------
   Doet:
     - HTTP -> HTTPS redirect
     - Basic Auth (Apache-niveau, voor alle paths)
     - Reverse proxy naar gunicorn op 127.0.0.1:5000
     - Stuurt X-Forwarded-* mee zodat Flask-Limiter de echte client-IP
       ziet (niet 127.0.0.1, want dan zou rate limit globaal werken).

   Security headers en TLS-config komen GEDEELTELIJK uit de globale snippets:
     /etc/apache2/conf-enabled/ssl-hardening.conf      (TLS)
     /etc/apache2/conf-enabled/security-headers.conf   (HSTS, X-Frame, etc.)

   We voegen hier ALLEEN nog app-specifieke headers toe:
     - Content-Security-Policy (strikt, app-specifiek; Koha kan dit niet)
============================================================================ #}
<VirtualHost *:80>
    ServerName {{ scan_domain }}
    RewriteEngine On
    RewriteRule ^ https://{{ scan_domain }}%{REQUEST_URI} [L,R=301]
</VirtualHost>

<VirtualHost *:443>
    ServerName {{ scan_domain }}

    SSLEngine on
    SSLCertificateFile /etc/letsencrypt/live/{{ scan_domain }}/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/{{ scan_domain }}/privkey.pem

    # ---- Basic Auth ----
    # Geldt voor de hele app. htpasswd-file wordt door Ansible aangemaakt
    # uit vault. Audit-logs in scan-access.log tonen welke user inlogde.
    <Location />
        AuthType Basic
        AuthName "SAF bibliotheek - login vereist"
        AuthUserFile {{ flask_htpasswd_path }}
        Require valid-user
    </Location>

    # ---- Reverse proxy ----
    ProxyPreserveHost On
    ProxyRequests Off
    ProxyPass / http://{{ flask_bind }}/
    ProxyPassReverse / http://{{ flask_bind }}/

    # X-Forwarded-* zodat de Flask-app (via ProxyFix) de echte client-IP
    # ziet. Zonder dit krijgt Flask-Limiter altijd 127.0.0.1 en is
    # rate-limiting per IP zinloos.
    RequestHeader set X-Forwarded-Proto "https"
    RequestHeader set X-Forwarded-Port "443"

    # ---- App-specifieke CSP ----
    # De scan-app is zelf geschreven en gebruikt alleen eigen CSS/JS. We
    # kunnen dus een strikte CSP afdwingen. Koha kan dit niet vanwege veel
    # inline JS — daarom staat CSP NIET in security-headers.conf maar hier.
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

    ErrorLog ${APACHE_LOG_DIR}/scan-error.log
    CustomLog ${APACHE_LOG_DIR}/scan-access.log combined
</VirtualHost>
