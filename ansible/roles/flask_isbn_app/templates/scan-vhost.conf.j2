<VirtualHost *:80>
    ServerName {{ scan_domain }}
    RewriteEngine On
    RewriteRule ^ https://{{ scan_domain }}%{REQUEST_URI} [L,R=301]
</VirtualHost>

<VirtualHost *:443>
    ServerName {{ scan_domain }}

    SSLEngine on
    SSLCertificateFile /etc/letsencrypt/live/{{ scan_domain }}/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/{{ scan_domain }}/privkey.pem

    # Reverse proxy naar gunicorn
    ProxyPreserveHost On
    ProxyRequests Off
    ProxyPass / http://{{ flask_bind }}/
    ProxyPassReverse / http://{{ flask_bind }}/

    # Security headers
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
    Header always set X-Frame-Options SAMEORIGIN
    Header always set X-Content-Type-Options nosniff
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    ErrorLog ${APACHE_LOG_DIR}/scan-error.log
    CustomLog ${APACHE_LOG_DIR}/scan-access.log combined
</VirtualHost>
