[Unit]
Description=Flask ISBN scan app voor Koha
After=network.target

[Service]
Type=simple
User={{ flask_user }}
Group={{ flask_group }}

WorkingDirectory={{ flask_app_dir }}

# Environment
Environment="KOHA_UPLOAD_DIR={{ flask_staging_dir }}"
Environment="PATH={{ flask_venv_dir }}/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
EnvironmentFile=-{{ flask_app_dir }}/.flask_env

# Lees secret key uit bestand (LoadCredential houdt het uit /proc/<pid>/environ)
ExecStartPre=/bin/sh -c 'echo "FLASK_SECRET_KEY=$(cat {{ flask_app_dir }}/.flask_secret)" > {{ flask_app_dir }}/.flask_env && chmod 600 {{ flask_app_dir }}/.flask_env'

ExecStart={{ flask_venv_dir }}/bin/gunicorn \
    --workers {{ flask_workers }} \
    --bind {{ flask_bind }} \
    --access-logfile - \
    --error-logfile - \
    run:app

Restart=on-failure
RestartSec=5

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Sta schrijven toe in onze eigen dirs
ReadWritePaths={{ flask_app_dir }} {{ flask_staging_dir }}
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

# Logging naar journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=flask-isbn

[Install]
WantedBy=multi-user.target
