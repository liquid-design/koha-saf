[Unit]
Description=Importeer MARCXML bestanden uit staging naar Koha
Documentation=man:systemd.service(5)
ConditionPathExists={{ flask_staging_dir }}

[Service]
Type=oneshot
# Draait als root omdat we 'koha-shell <instance>' aanroepen, en die wrapper
# switcht zelf naar de juiste koha-user. De security boundary ligt aan de
# Flask kant: flask-isbn schrijft enkel naar staging. Deze service is een
# trusted post-staging pipeline die Koha's eigen tooling aanroept.
User=root
Group=root

ExecStart={{ koha_import_script_path }}

# Korte timeout: als import langer dan 10 min duurt is er iets goed mis
TimeoutStartSec=600

# Logging naar journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=koha-import

# Geen sandbox-restricties: koha-shell + commit_file.pl heeft toegang nodig
# tot Koha's eigen log-, cache-, run-paths en moet sudo kunnen doen voor
# user-switching. De aparte flask-isbn user en staging-dir zijn de echte
# security boundary van deze pipeline.

[Install]
WantedBy=
