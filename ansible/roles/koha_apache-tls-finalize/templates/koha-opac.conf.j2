{# ============================================================================
   Koha OPAC vhost — TLS + Koha-shared includes
   Managed by Ansible (koha_apache-tls-finalize role)
   ----------------------------------------------------------------------------
   Security headers en TLS-config komen uit:
     /etc/apache2/conf-enabled/ssl-hardening.conf
     /etc/apache2/conf-enabled/security-headers.conf
   Beide worden door de apache_hardening role geplaatst en geactiveerd.
   Voeg hier dus GEEN HSTS/X-Frame/etc. meer toe — dat zou dubbel zijn.
============================================================================ #}
<VirtualHost *:80>
 ServerName {{ koha_opac_domain }}
 RewriteEngine On
 RewriteRule ^ https://{{ koha_opac_domain }}%{REQUEST_URI} [L,R=301]
</VirtualHost>

<VirtualHost *:443>
 ServerName {{ koha_opac_domain }}

 SSLEngine on
 SSLCertificateFile /etc/letsencrypt/live/{{ koha_opac_domain }}/fullchain.pem
 SSLCertificateKeyFile /etc/letsencrypt/live/{{ koha_opac_domain }}/privkey.pem

 Define instance "{{ koha_instance }}"

 Include /etc/koha/apache-shared.conf
 Include /etc/koha/apache-shared-opac-plack.conf
 Include /etc/koha/apache-shared-opac.conf

 SetEnv KOHA_CONF "/etc/koha/sites/{{ koha_instance }}/koha-conf.xml"
 AssignUserID {{ koha_user }} {{ koha_user }}

 ErrorLog /var/log/koha/{{ koha_instance }}/opac-error.log
 CustomLog /var/log/koha/{{ koha_instance }}/opac-access.log combined
</VirtualHost>
